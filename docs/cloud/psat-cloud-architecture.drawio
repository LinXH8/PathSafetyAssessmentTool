          <mxGeometry x="20" y="60" width="78" height="78" as="geometry" />
        </mxCell>

        <!-- Public subnet -->
        <mxCell id="subnet" value="Public subnet 10.0.1.0/24 &#xb7; single AZ &#xb7; route 0.0.0.0/0 &#x2192; IGW" style="outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#7AA116;fillColor=#F2F6E8;verticalAlign=top;align=left;spacingLeft=30;fontColor=#248814;dashed=0;" vertex="1" parent="vpc">
          <mxGeometry x="140" y="40" width="620" height="680" as="geometry" />
        </mxCell>
        <mxCell id="eip" value="Elastic IP" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elastic_ip_address;" vertex="1" parent="subnet">
          <mxGeometry x="20" y="20" width="78" height="78" as="geometry" />
        </mxCell>

        <!-- Security group -->
        <mxCell id="sg" value="Security group path-psat-dev-ec2-sg: TCP 80 from the CloudFront origin-facing prefix list ONLY &#xb7; no SSH &#xb7; all egress" style="fillColor=none;strokeColor=#DD3522;verticalAlign=top;fontStyle=0;fontColor=#DD3522;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeWidth=2;rounded=1;arcSize=4;align=left;spacingLeft=10;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;" vertex="1" parent="subnet">
          <mxGeometry x="120" y="30" width="480" height="630" as="geometry" />
        </mxCell>

        <!-- EC2 instance -->
        <mxCell id="ec2" value="EC2 path-psat-dev-ec2 &#xb7; m6i.xlarge &#xb7; Amazon Linux 2023 &#xb7; 150 GB gp3 (encrypted) &#xb7; IMDSv2 &#xb7; Docker Compose" style="outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_ec2_instance_contents;strokeColor=#D86613;fillColor=#FFFFFF;verticalAlign=top;align=left;spacingLeft=30;fontColor=#D86613;dashed=0;" vertex="1" parent="sg">
          <mxGeometry x="20" y="40" width="440" height="570" as="geometry" />
        </mxCell>
        <mxCell id="nginx" value="&lt;b&gt;frontend container&lt;/b&gt; &#x2013; nginx :80&#xa;React SPA &#xb7; proxies /api/* to backend &#xb7; 3600 s proxy timeout, 2 GB body" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="ec2">
          <mxGeometry x="30" y="60" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="backend" value="&lt;b&gt;backend container&lt;/b&gt; &#x2013; Flask + waitress :8000 (loopback only)&#xa;YOLO auto-coding (CPU) &#xb7; GIS lookups &#xb7; CycleRAP scoring&#xa;per-browser PIN session cookie &#xb7; PSAT_COOKIE_SECURE=1 &#xb7; PSAT_SKIP_UPDATE_CHECK=1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="ec2">
          <mxGeometry x="30" y="150" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="volumes" value="&lt;b&gt;Bind mounts from /opt/psat-repo (survive rebuilds)&lt;/b&gt;&#xa;data/ &#xb7; profiles/ &#xb7; Generated Reports/ &#x2013; projects, logins, exports&#xa;in/ &#x2013; survey images (filled by the sync timer below)&#xa;backend/models &#xb7; backend/shapefiles &#xb7; scoring JSONs (from 15-psat-assets)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="ec2">
          <mxGeometry x="30" y="260" width="380" height="110" as="geometry" />
        </mxCell>
        <mxCell id="sync" value="&lt;b&gt;systemd timer psat-sync-in&lt;/b&gt; &#x2013; every 2 min&#xa;aws s3 sync s3://path-psat-dev-uploads/ /opt/psat-repo/in/ (no --delete)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="ec2">
          <mxGeometry x="30" y="410" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="role" value="Instance role path-psat-dev-ec2-role: AmazonSSMManagedInstanceCore + s3:ListBucket / s3:GetObject on both buckets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="ec2">
          <mxGeometry x="30" y="500" width="380" height="50" as="geometry" />
        </mxCell>

        <!-- Regional services outside the VPC -->
        <mxCell id="bucket" value="S3 path-psat-dev-uploads&#xa;bucket root = in/&#xa;versioned &#xb7; SSE-S3&#xa;TLS only &#xb7; no public access" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="region">
          <mxGeometry x="880" y="60" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="ssm" value="Systems Manager&#xa;Session Manager&#xa;(admin shell, no SSH)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.systems_manager;" vertex="1" parent="region">
          <mxGeometry x="880" y="300" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="iamuser" value="IAM user&#xa;path-psat-dev-uploader&#xa;PutObject + ListBucket only&#xa;(no GetObject, no Delete)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;" vertex="1" parent="region">
          <mxGeometry x="1040" y="300" width="78" height="78" as="geometry" />
        </mxCell>

        <!-- Operations note -->
        <mxCell id="note" value="&lt;b&gt;How it is deployed and operated&lt;/b&gt;&#xa;&#x2022; Terraform (env/dev) provisions everything shown. The instance user-data installs Docker, the Compose plugin and the psat-sync-in timer only; the app is bootstrapped once over SSM: git clone refactor/cloud-deployment into /opt/psat-repo, sync models / shapefiles / scoring JSONs from 15-psat-assets, write docker-compose.override.yml (asset mounts, PSAT_SKIP_UPDATE_CHECK=1, PSAT_COOKIE_SECURE=1, backend port on loopback), then docker compose up --build -d.&#xa;&#x2022; Code update = git pull &amp;&amp; docker compose up --build -d. New surveys need no deploy: upload the folder to path-psat-dev-uploads (survey_upload.md) and the timer copies it into in/ within 2 minutes.&#xa;&#x2022; The Elastic IP answers only to CloudFront's origin-facing IP ranges, so the WAF cannot be bypassed. No SSH; admin access is SSM Session Manager. Login is a per-browser PIN session cookie (Secure, because viewers arrive over HTTPS)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=10;spacingRight=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="260" y="1160" width="1200" height="150" as="geometry" />
        </mxCell>

