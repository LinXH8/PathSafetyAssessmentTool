        <mxCell id="title" value="PSAT cloud pilot &#x2013; CloudFront + WAF in front of one EC2 running Docker Compose; survey folders arrive via S3" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
