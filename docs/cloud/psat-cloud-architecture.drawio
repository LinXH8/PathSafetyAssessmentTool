        <!-- Global edge: CloudFront + WAF -->
        <mxCell id="global" value="Global edge &#xb7; CloudFront distribution + WAFv2 web ACL (CLOUDFRONT scope, created in us-east-1)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8C4FFF;fontColor=#8C4FFF;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=10;fontSize=12;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;" vertex="1" parent="cloud">
          <mxGeometry x="20" y="40" width="1160" height="200" as="geometry" />
        </mxCell>
        <mxCell id="cloudfront" value="&lt;b&gt;CloudFront path-psat-dev-cdn&lt;/b&gt;&#xa;https://d13nyc943hd6xx.cloudfront.net&#xa;TLS for viewers (redirect-to-https), default *.cloudfront.net cert&#xa;Default: CachingDisabled + AllViewer (dynamic API) &#xb7; /assets/*: CachingOptimized&#xa;Origin = EIP over plain HTTP :80, read timeout 60 s &#xb7; PriceClass_200" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;spacingLeft=6;" vertex="1" parent="global">
          <mxGeometry x="200" y="60" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="waf" value="&lt;b&gt;WAF web ACL path-psat-dev-waf&lt;/b&gt;&#xa;AWSManagedRulesCommonRuleSet&#xa;AWSManagedRulesKnownBadInputsRuleSet&#xa;Rate limit 2000 requests / 5 min per IP&#xa;CloudWatch metrics + sampled requests" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.waf;spacingLeft=6;" vertex="1" parent="global">
          <mxGeometry x="760" y="60" width="78" height="78" as="geometry" />
        </mxCell>

