# Python bytecode cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pdb

# Virtual environments
.venv/
env/
venv/

# OS cache files
.DS_Store
Thumbs.db

# Log files
*.log

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# IDE configuration
.vscode/
.idea/

# Data files (if you don't want to commit real data)
data/
models/
shapefiles/

# Exception: track everything under data/ (defect reference data, custom
# attribute options) instead of the generic data/ ignore above.
!data/

# Exception: promoted road gradient profiles are the deliverable of the gradient
# workflow (see .clinerules/gradient-runner.md) and are shared with the team.
# Git will not descend into an excluded directory, so re-include the parent
# first, then re-exclude everything in it except gradient_profiles/.
# This mirrors the same exception in the repo-root .gitignore; a nested
# .gitignore takes precedence for paths under backend/, so both are needed.
!shapefiles/
shapefiles/*
!shapefiles/gradient_profiles/
# ... and keep the per-road build logs, which *.log above would otherwise drop
!shapefiles/gradient_profiles/**/*.log

# Stale pre-rename duplicate of app/api/gis_layers/ (superseded, dead code —
# see gis_layers/routes.py docstring). The !shapefiles/ re-include above
# unintentionally un-ignores this unrelated module dir too; re-exclude it.
app/api/shapefiles/

# Temporary files
*.tmp
*.bak
*.swp

# The data/ exception above should win even for the *.bak backup copy kept
# alongside the live defect summary spreadsheet.
!data/defects/defect_summary.xlsx.bak

backend_log.txt
